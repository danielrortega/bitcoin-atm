[btcpay]
host = https://your.btcpay.server
store_id = your_store_id
api_token = encrypted_api_token_here
currency = BRL
; Rede em que este ATM opera: mainnet, testnet (cobre signet) ou regtest.
; Define quais endereços e invoices a tela aceita — um ATM de mainnet recusa
; um endereço de testnet escaneado por engano, em vez de aceitar o dinheiro e
; só falhar na hora do envio. PRECISA bater com a rede da carteira do BTCPay.
; Ausente ou inválida, assume mainnet (o lado seguro para errar).
network = mainnet
; Código da cripto usada no BTCPay (normalmente BTC). Usado nos endpoints
; on-chain e Lightning. Para testnet o cryptoCode continua sendo BTC.
crypto_code = BTC
; (Opcional) Sobrescreve o paymentMethodId on-chain. Padrão: <crypto_code>-CHAIN
; (ex.: BTC-CHAIN). Use 'onchain' apenas em instâncias BTCPay muito antigas.
; onchain_payment_method = BTC-CHAIN
; --- Legado: não são mais usados pelos endpoints atuais do Greenfield ---
; wallet_id = your_wallet_id
; lightning_wallet_id = your_lightning_wallet_id

[atm]
; Teto por transação em BRL. A aceitação de cédulas para quando o total
; inserido atinge este valor (pode ser excedido por no máximo uma cédula,
; pois a nota já está dentro da máquina quando o valor é lido).
max_transaction_brl = 1000

[hardware]
; Porta serial do noteiro. Na POC (sem noteiro), use a porta virtual do socat,
; ex.: /tmp/ttyV1
serial_port = /dev/ttyUSB0
baud_rate = 9600
; ID USB da impressora ESC/POS no formato vendor:product (veja `lsusb`),
; ex.: 0416:5011
printer_usb = usb_printer_id

; Alertas do Telegram não são configurados aqui: o destino fica no arquivo do
; próprio telegram-send (`telegram-send --configure`), que o ATM usa ao enviar.
